<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+向けのクラウドバックアップ・端末間転送設定(Security issue #4、backup_rules.xmlと同趣旨)。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
